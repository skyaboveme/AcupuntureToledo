---
import { site } from '../data/site';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/conditions', label: 'Conditions' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream-50/95 backdrop-blur-sm border-b border-sage-200">
  <div class="container-narrow">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center shrink-0 group" aria-label={`${site.name} — Home`}>
        <img
          src="/images/logo2.webp"
          alt={site.name}
          width="1880"
          height="219"
          class="h-8 sm:h-9 md:h-11 w-auto max-w-[200px] sm:max-w-[260px] md:max-w-[360px] object-contain object-left"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-2.5 py-2 rounded-md text-sm font-medium transition-colors whitespace-nowrap',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-teal-700 bg-sage-100'
                  : 'text-warm-700 hover:text-teal-700 hover:bg-sage-50',
              ]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a
          href={`tel:${site.phoneTel}`}
          class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-600 hover:bg-sage-100 transition-colors rounded-lg p-2 lg:px-3 lg:py-2 whitespace-nowrap"
          aria-label={`Call ${site.phone}`}
        >
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            />
          </svg>
          <span class="hidden lg:inline">{site.phone}</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold rounded-lg p-2 lg:px-4 lg:py-2.5 transition-colors whitespace-nowrap"
          aria-label="Book appointment"
        >
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
          <span class="hidden sm:inline">Book Appointment</span>
        </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-md text-sage-700 hover:bg-sage-100 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-menu"
    class="lg:hidden hidden border-t border-sage-200 bg-cream-50"
    aria-label="Mobile navigation"
  >
    <div class="container-narrow py-4 space-y-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'block px-4 py-3 rounded-lg text-base font-medium transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-teal-700 bg-sage-100'
                : 'text-warm-700 hover:bg-sage-50',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-4 px-4 space-y-3 border-t border-sage-200 mt-4">
        <a href={`tel:${site.phoneTel}`} class="flex items-center gap-2 text-teal-700 font-semibold">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            />
          </svg>
          Call {site.phone}
        </a>
        <a
          href="/contact"
          class="flex items-center justify-center gap-2 w-full text-center bg-teal-600 text-white font-semibold px-5 py-3 rounded-lg"
        >
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
          Book Appointment
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
    btn?.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
