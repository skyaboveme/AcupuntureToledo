---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  limit?: number;
}

const { items, limit } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
---

<div class="space-y-3" role="list">
  {
    displayItems.map((item, index) => (
      <details
        class="group bg-white rounded-xl border border-sage-200 overflow-hidden"
        role="listitem"
      >
        <summary
          class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold text-sage-800 hover:bg-sage-50 transition-colors list-none [&::-webkit-details-marker]:hidden"
        >
          <span>{item.question}</span>
          <svg
            class="h-5 w-5 text-teal-600 shrink-0 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-5 pb-5 text-warm-700 leading-relaxed border-t border-sage-100 pt-4">
          {item.answer}
        </div>
      </details>
    ))
  }
</div>
