---
import { site } from '../data/site';

const quickLinks = [
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/conditions', label: 'Conditions We Treat' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/faq', label: 'FAQ' },
  { href: '/billing', label: 'Insurance & Billing' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-sage-900 text-sage-200">
  <div class="container-narrow section-padding pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <h2 class="font-serif text-xl text-white mb-4">{site.name}</h2>
        <p class="text-sm leading-relaxed mb-4">{site.tagline}</p>
        <p class="text-sm">{site.legalName}</p>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={site.facebook}
              class="text-sm hover:text-white transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Contact</h3>
        <address class="not-italic text-sm space-y-2">
          <p>{site.address.full}</p>
          <p>
            <a href={`tel:${site.phoneTel}`} class="hover:text-white transition-colors">
              {site.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">
              {site.email}
            </a>
          </p>
        </address>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Office Hours</h3>
        <ul class="text-sm space-y-1">
          {
            site.hours.map((h) => (
              <li class="flex justify-between gap-4">
                <span>{h.day}</span>
                <span class="text-sage-300">{h.hours}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-sage-700 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-sage-400">
      <p>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <p>Serving {site.region}</p>
    </div>
  </div>
</footer>
