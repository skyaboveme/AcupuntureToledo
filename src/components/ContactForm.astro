---
import { site } from '../data/site';

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;

// TODO: Wire up form backend before go-live (Formspree, Netlify Forms, serverless function, etc.)
// Replace FORM_ACTION with your endpoint URL
const FORM_ACTION = '#'; // Stub — see README for setup instructions
---

{showTitle && (
  <div class="mb-8">
    <h2 class="text-2xl font-serif text-sage-900 mb-2">Send Us a Message</h2>
    <p class="text-warm-700">
      Fill out the form below and our team will get back to you. You can also call{' '}
      <a href={`tel:${site.phoneTel}`} class="text-teal-700 hover:text-teal-600 font-semibold">
        {site.phone}
      </a>{' '}
      or email{' '}
      <a href={`mailto:${site.email}`} class="text-teal-700 hover:text-teal-600">
        {site.email}
      </a>.
    </p>
  </div>
)}

<form
  id="contact-form"
  action={FORM_ACTION}
  method="POST"
  class="space-y-6"
  novalidate
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-semibold text-sage-800 mb-2">
        Full Name <span class="text-teal-600" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full px-4 py-3 rounded-lg border border-sage-300 bg-white focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-colors"
        aria-describedby="name-error"
      />
      <p id="name-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
    </div>

    <div>
      <label for="phone" class="block text-sm font-semibold text-sage-800 mb-2">
        Phone Number <span class="text-teal-600" aria-label="required">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        class="w-full px-4 py-3 rounded-lg border border-sage-300 bg-white focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-colors"
        aria-describedby="phone-error"
      />
      <p id="phone-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
    </div>
  </div>

  <div>
    <label for="email" class="block text-sm font-semibold text-sage-800 mb-2">
      Email Address <span class="text-teal-600" aria-label="required">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="w-full px-4 py-3 rounded-lg border border-sage-300 bg-white focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-colors"
      aria-describedby="email-error"
    />
    <p id="email-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-sage-800 mb-2">
      Message <span class="text-teal-600" aria-label="required">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="w-full px-4 py-3 rounded-lg border border-sage-300 bg-white focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-colors resize-y"
      aria-describedby="message-error"
    ></textarea>
    <p id="message-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
  </div>

  <div id="form-status" class="hidden p-4 rounded-lg text-sm" role="status"></div>

  <button
    type="submit"
    class="w-full sm:w-auto bg-teal-600 hover:bg-teal-700 text-white font-semibold px-8 py-4 rounded-lg transition-colors"
  >
    Send Message
  </button>

  <p class="text-sm text-sage-600 italic">
    Note: This form requires a backend service to be configured before go-live. See README for setup instructions.
  </p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');

  const validators: Record<string, (value: string) => string | null> = {
    name: (v) => (v.trim().length < 2 ? 'Please enter your full name.' : null),
    phone: (v) => (/^[\d\s\-().+]{7,}$/.test(v.trim()) ? null : 'Please enter a valid phone number.'),
    email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? null : 'Please enter a valid email address.'),
    message: (v) => (v.trim().length < 10 ? 'Please enter a message (at least 10 characters).' : null),
  };

  function showError(fieldId: string, message: string | null) {
    const input = document.getElementById(fieldId) as HTMLInputElement;
    const errorEl = document.getElementById(`${fieldId}-error`);
    if (message) {
      input?.setAttribute('aria-invalid', 'true');
      errorEl!.textContent = message;
      errorEl?.classList.remove('hidden');
    } else {
      input?.removeAttribute('aria-invalid');
      errorEl?.classList.add('hidden');
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let valid = true;

    Object.entries(validators).forEach(([field, validate]) => {
      const input = document.getElementById(field) as HTMLInputElement;
      const error = validate(input?.value || '');
      showError(field, error);
      if (error) valid = false;
    });

    if (!valid) return;

    const action = form.getAttribute('action');
    if (!action || action === '#') {
      statusEl!.className = 'p-4 rounded-lg text-sm bg-amber-50 text-amber-800 border border-amber-200';
      statusEl!.textContent =
        'Form validation passed. A form backend (Formspree, Netlify Forms, etc.) must be configured before messages can be sent. See README.';
      statusEl?.classList.remove('hidden');
      return;
    }

    form.submit();
  });
</script>
