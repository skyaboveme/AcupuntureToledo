---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageHero from '../components/PageHero.astro';
import { conditions } from '../data/conditions';
import { buildPageSchema } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Conditions We Treat — Chiropractic & Acupuncture in Toledo',
  description:
    'Toledo Holistic Healthcare treats back pain, neck pain, headaches, whiplash and auto injuries, sports injuries, work injuries, and fertility support in Toledo, OH.',
  path: '/conditions',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/conditions',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Conditions', path: '/conditions' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/conditions"
  ogImage="/images/1920-chiro-086.webp"
  ogImageAlt="Chiropractic care for common conditions at Toledo Holistic Healthcare"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Conditions', path: '/conditions' },
  ]}
>
  <PageHero title="Conditions We Treat" image="/images/1920-chiro-086.webp" alt="Chiropractic care for common conditions in Toledo, Ohio">
    <p>
      Dr. Allen Beck provides drug-free, holistic care for the conditions patients throughout Toledo and NW Ohio bring to us most often. Choose a condition to read how we treat it.
    </p>
  </PageHero>

  <section class="section-padding bg-white">
    <div class="container-narrow grid grid-cols-1 sm:grid-cols-2 gap-8">
      {
        conditions.map((condition) => (
          <article id={condition.slug} class="scroll-mt-24 overflow-hidden rounded-2xl border border-sage-200 bg-cream-50">
            <a href={`/conditions/${condition.slug}`} class="group block">
              <img
                src={condition.image}
                alt={condition.imageAlt}
                width="1000"
                height="750"
                class="w-full aspect-[16/10] object-cover"
              />
              <div class="p-6">
                <h2 class="text-2xl font-serif mb-2 group-hover:text-teal-700 transition-colors">{condition.name}</h2>
                <p class="text-warm-700 leading-relaxed mb-4">{condition.shortDescription}</p>
                <span class="text-teal-700 font-semibold text-sm">Read more →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <CTABanner />
</BaseLayout>
