---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Page Not Found',
  description: 'The page you requested was not found. Return to Toledo Holistic Healthcare to book an appointment or browse our services.',
  path: '/404',
});
---

<BaseLayout title={pageSeo.title} description={pageSeo.description} path="/404" noindex>
  <section class="section-padding">
    <div class="container-narrow text-center max-w-2xl">
      <p class="text-teal-700 font-semibold mb-3">404</p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6">We could not find that page</h1>
      <p class="text-warm-700 text-lg mb-8">
        The link may be outdated. Visit our home page, browse services, or call the office to book an appointment.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/">Back to Home</Button>
        <Button href="/contact" variant="outline">Book Appointment</Button>
      </div>
    </div>
  </section>
</BaseLayout>
