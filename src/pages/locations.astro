---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { buildPageSchema } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Toledo Office Location — Chiropractic & Acupuncture',
  description:
    'Visit Toledo Holistic Healthcare at 2828 W Central Ave, Suite 1, Toledo, OH 43606. Serving Lucas County and NW Ohio. Call 419-472-7055.',
  path: '/locations',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/locations',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Locations', path: '/locations' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/locations"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Locations', path: '/locations' },
  ]}
>
  <PageHero title="Our Toledo Location" image="/images/toledo-hero.webp" alt="Toledo, Ohio">
    <p>
      Toledo Holistic Healthcare is a chiropractic and acupuncture clinic located in Toledo. We serve Lucas County and the surrounding areas of NW Ohio.
    </p>
  </PageHero>

  <section class="section-padding bg-white">
    <div class="container-narrow">
      <article class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <figure class="overflow-hidden rounded-2xl bg-sage-100">
          <img
            src="/images/tol-office.webp"
            alt="Toledo Holistic Healthcare office at 2828 W Central Ave"
            width="800"
            height="520"
            class="w-full h-full object-cover"
          />
        </figure>
        <div>
          <h2 class="text-2xl font-serif mb-4">Toledo Office</h2>
          <address class="not-italic text-warm-700 leading-relaxed mb-6">
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </address>
          <p class="mb-2">
            <a href={`tel:${site.phoneTel}`} class="text-teal-700 font-semibold hover:text-teal-600">{site.phone}</a>
          </p>
          <p class="mb-6">
            <a href={`mailto:${site.email}`} class="text-teal-700 hover:text-teal-600">{site.email}</a>
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={site.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-lg"
            >
              Open the map
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center border-2 border-teal-600 text-teal-700 hover:bg-teal-600 hover:text-white font-semibold px-6 py-3 rounded-lg"
            >
              Book a visit
            </a>
          </div>
        </div>
      </article>

      <div class="mt-12 rounded-2xl overflow-hidden border border-sage-200">
        <iframe
          title={`Map of ${site.name}`}
          src={site.mapEmbedUrl}
          class="w-full h-80 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
