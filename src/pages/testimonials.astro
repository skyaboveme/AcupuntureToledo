---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { testimonials } from '../data/testimonials';
import { buildPageSchema, reviewSchemas } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Patient Testimonials — Toledo Holistic Healthcare',
  description:
    'Read real patient reviews of Dr. Jared Mainous, DC, and Toledo Holistic Healthcare. Chiropractic and acupuncture care in Toledo, NW Ohio.',
  path: '/testimonials',
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...reviewSchemas([...testimonials]),
  ],
};
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/testimonials"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Testimonials', path: '/testimonials' },
  ]}
>
  <section class="section-padding bg-gradient-to-b from-sage-50 to-cream-50">
    <div class="container-narrow text-center">
      <h1 class="text-4xl md:text-5xl font-serif mb-6">Patient Testimonials</h1>
      <p class="text-lg text-warm-700 leading-relaxed max-w-2xl mx-auto">
        Hear from real patients who have experienced the difference of holistic, patient-centered care at Toledo Holistic Healthcare.
      </p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.map((t) => <TestimonialCard quote={t.quote} author={t.author} />)}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
