---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import PhoneLink from '../components/PhoneLink.astro';
import EmailLink from '../components/EmailLink.astro';
import { site } from '../data/site';
import { buildPageSchema } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Contact & Book Appointment — Toledo Holistic Healthcare',
  description:
    'Contact Toledo Holistic Healthcare at 2828 W Central Ave, Suite 1, Toledo, OH 43606. Call 419-472-7055 or email faq@acupuncturetoledo.com to book.',
  path: '/contact',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/contact',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/contact"
  ogImage="/images/1920-chiro-001.webp"
  ogImageAlt="Toledo Holistic Healthcare clinic interior in Toledo, Ohio"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]}
>
  <PageHero title="Contact Us" image="/images/1920-chiro-001.webp" alt="Contact Toledo Holistic Healthcare at 2828 W Central Ave, Suite 1">
    <p>
      Ready to start your wellness journey? Call, email, or fill out the form below. We are accepting new patients and look forward to hearing from you.
    </p>
  </PageHero>

  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <ContactForm />
        </div>

        <div class="space-y-8">
          <figure class="overflow-hidden rounded-2xl">
            <img
              src="/images/tol-office.webp"
              alt="Toledo Holistic Healthcare office at 2828 W Central Ave"
              width="800"
              height="520"
              class="w-full aspect-[16/10] object-cover"
            />
          </figure>

          <div class="bg-sage-50 rounded-2xl p-8 border border-sage-200">
            <h2 class="text-xl font-serif mb-6">Get in Touch</h2>
            <dl class="space-y-4">
              <div>
                <dt class="text-sm font-semibold text-sage-600 uppercase tracking-wide">Phone</dt>
                <dd class="mt-1">
                  <PhoneLink class="text-lg" />
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-sage-600 uppercase tracking-wide">Email</dt>
                <dd class="mt-1">
                  <EmailLink />
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-sage-600 uppercase tracking-wide">Address</dt>
                <dd class="mt-1 text-warm-700">
                  <address class="not-italic">
                    {site.address.street}<br />
                    {site.address.city}, {site.address.state} {site.address.zip}
                  </address>
                </dd>
              </div>
            </dl>
          </div>

          <div class="bg-cream-100 rounded-2xl p-8 border border-sage-200">
            <h2 class="text-xl font-serif mb-6">Office Hours</h2>
            <ul class="space-y-2">
              {
                site.hours.map((h) => (
                  <li class="flex justify-between text-warm-700">
                    <span class="font-medium">{h.day}</span>
                    <span>{h.hours}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-2xl overflow-hidden border border-sage-200">
            <iframe
              title={`Map of ${site.name}`}
              src={site.mapEmbedUrl}
              class="w-full aspect-[4/3] border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <div class="bg-sage-50 p-4 text-center">
              <a
                href={site.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-teal-700 hover:text-teal-600 font-semibold text-sm"
              >
                Open in Google Maps →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
