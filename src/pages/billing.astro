---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site } from '../data/site';
import { buildPageSchema } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'Insurance & Billing — Toledo Holistic Healthcare',
  description:
    "We work with most insurances including private insurance for car accidents and workers compensation. We work closely with Veteran's Affairs and provide a reasonable fee base without coverage.",
  path: '/billing',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/billing',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Insurance & Billing', path: '/billing' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/billing"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Insurance & Billing', path: '/billing' },
  ]}
>
  <section class="section-padding bg-gradient-to-b from-sage-50 to-cream-50">
    <div class="container-narrow">
      <h1 class="text-4xl md:text-5xl font-serif mb-6">Insurance & Billing</h1>
      <p class="text-lg text-warm-700 leading-relaxed max-w-3xl">
        We work with most insurances including private insurance for car accidents and workers compensation. We work closely with Veteran's Affairs to ensure veterans get the care they deserve. We also provide a very reasonable fee base in the absence of coverage.
      </p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-narrow grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-2xl font-serif mb-4">What we can help with</h2>
        <p class="text-warm-700 leading-relaxed mb-4">
          Lori C., our office administrator, manages scheduling and insurance support. Patients often mention that she does everything possible to work with their schedule and insurance questions.
        </p>
        <ul class="space-y-3 text-warm-700">
          <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span> Most private insurance plans</li>
          <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span> Auto accident (personal injury) coverage</li>
          <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span> Workers compensation</li>
          <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span> Veteran's Affairs</li>
          <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span> Reasonable self-pay fees when coverage is absent</li>
        </ul>
        <p class="text-sm text-sage-600 mt-6 italic">
          TODO: Add a specific insurance panel list (carrier names) once the office confirms which plans are in-network.
        </p>
      </div>
      <div class="bg-sage-50 rounded-2xl p-8 border border-sage-200">
        <h2 class="text-xl font-serif mb-4">Questions about coverage?</h2>
        <p class="text-warm-700 mb-6">
          Call the office and we will help you understand your options before your first visit.
        </p>
        <a
          href={`tel:${site.phoneTel}`}
          class="inline-flex items-center justify-center bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-lg"
        >
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
