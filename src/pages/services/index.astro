---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { services } from '../../data/services';
import { buildPageSchema } from '../../lib/schema';
import { seo } from '../../lib/seo';

const pageSeo = seo({
  title: 'Holistic Health Services in Toledo, OH',
  description:
    'Chiropractic, acupuncture, cupping, fertility support, pregnancy care, cold laser therapy, and more at Toledo Holistic Healthcare.',
  path: '/services',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/services',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/services"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]}
>
  <PageHero title="Our Services" image="/images/1920-chiro-014.webp">
    <p>
      Toledo Holistic Healthcare offers a comprehensive range of holistic health services. Each treatment is tailored to your individual needs, combining Eastern healing wisdom with modern clinical expertise.
    </p>
  </PageHero>

  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          services.map((service) => (
            <article class="overflow-hidden rounded-2xl border border-sage-200 hover:border-teal-400 hover:shadow-md transition-all bg-cream-50">
              <img
                src={service.image}
                alt=""
                width="800"
                height="600"
                class="w-full aspect-[16/10] object-cover"
              />
              <div class="p-8">
                <h2 class="text-2xl font-serif text-sage-800 mb-3">
                  <a href={`/services/${service.slug}`} class="hover:text-teal-700 transition-colors">
                    {service.name}
                  </a>
                </h2>
                <p class="text-warm-700 leading-relaxed mb-4">{service.shortDescription}</p>
                <ul class="space-y-1 mb-6">
                  {service.benefits.slice(0, 3).map((benefit) => (
                    <li class="text-sm text-sage-700 flex items-start gap-2">
                      <span class="text-teal-600 mt-0.5" aria-hidden="true">✓</span>
                      {benefit}
                    </li>
                  ))}
                </ul>
                <Button href={`/services/${service.slug}`} variant="outline" size="sm">
                  Learn More
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
