---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import { faqs } from '../data/faq';
import { buildPageSchema } from '../lib/schema';
import { seo } from '../lib/seo';

const pageSeo = seo({
  title: 'FAQ — Toledo Holistic Healthcare',
  description:
    'FAQ for Toledo Holistic Healthcare: first visits, kids, pregnancy, acupuncture, auto insurance, parking, and how to book in Toledo, OH.',
  path: '/faq',
});

const schema = buildPageSchema({
  description: pageSeo.description,
  path: '/faq',
  faqs: [...faqs],
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ],
});
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  path="/faq"
  ogImage="/images/1920-chiro-023.webp"
  ogImageAlt="Acupuncture and chiropractic FAQ at Toledo Holistic Healthcare"
  schema={schema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]}
>
  <PageHero title="Frequently Asked Questions" image="/images/1920-chiro-023.webp" alt="Answers about chiropractic and acupuncture care in Toledo, Ohio">
    <p>
      Find answers to common questions about our practice, services, insurance, and scheduling.
    </p>
  </PageHero>

  <section class="section-padding bg-white">
    <div class="container-narrow max-w-3xl">
      <FAQAccordion items={[...faqs]} />
    </div>
  </section>

  <CTABanner />
</BaseLayout>
